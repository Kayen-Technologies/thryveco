# ─── Server ───────────────────────────────────────────────────────────
# Must EXACTLY match the origin you open in the browser (scheme + host, no trailing slash).
# Local:  http://localhost:3000
# Prod:   https://thryveco-wheat.vercel.app  (NOT https://your-domain.vercel.app)
# A mismatch causes CSRF to drop the auth cookie → "You are not allowed to perform this action."
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Database ─────────────────────────────────────────────────────────
# Create locally: createdb thryveco
DATABASE_URL=postgresql://postgres:password@localhost:5432/thryveco

# Payload also accepts DATABASE_URI or POSTGRES_URL as fallbacks.

# ─── Payload ──────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
PAYLOAD_SECRET=replace-with-a-random-32-char-string

# ─── Media storage ────────────────────────────────────────────────────
# Leave empty locally — uploads go to /public/media
# Set when deploying to Vercel with Blob storage connected
BLOB_READ_WRITE_TOKEN=

# ─── Email (Resend) ───────────────────────────────────────────────────
RESEND_API_KEY=
CONTACT_TO_EMAIL=hello@thryveco.agency
# Must be an address on a domain verified at resend.com/domains, otherwise
# Resend treats the send as a test and only delivers to the account owner.
CONTACT_FROM_EMAIL=Thryve & Co. <hello@thryveco.agency>
